# syntax=docker/dockerfile:1
# Development image. Source is bind-mounted by compose; node_modules is a volume.

FROM node:24-alpine
WORKDIR /src
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install
COPY . .
EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
